diff --git a/cmake/macros/FindOpenSSL.cmake b/cmake/macros/FindOpenSSL.cmake
index 54e0297..998c311 100644
--- a/cmake/macros/FindOpenSSL.cmake
+++ b/cmake/macros/FindOpenSSL.cmake
@@ -194,6 +194,23 @@ if (OPENSSL_INCLUDE_DIR)
     file(STRINGS "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" openssl_version_str
          REGEX "^# *define[\t ]+OPENSSL_VERSION_NUMBER[\t ]+0x[0-9][0-9][0-9][0-9][0-9][0-9].*")
 
+    # OpenSSL 3.x defines OPENSSL_VERSION_NUMBER as a multi-line computed macro,
+    # so the single-line regex above matches nothing. Guard against the empty
+    # match (which would make the list(GET ...) calls below fail configure) and
+    # fall back to the discrete OPENSSL_VERSION_* macros introduced in 3.x.
+    if(NOT openssl_version_str)
+      file(STRINGS "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" openssl_version_major_str
+           REGEX "^# *define[\t ]+OPENSSL_VERSION_MAJOR[\t ]+[0-9]+.*")
+      file(STRINGS "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" openssl_version_minor_str
+           REGEX "^# *define[\t ]+OPENSSL_VERSION_MINOR[\t ]+[0-9]+.*")
+      file(STRINGS "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" openssl_version_patch_str
+           REGEX "^# *define[\t ]+OPENSSL_VERSION_PATCH[\t ]+[0-9]+.*")
+      string(REGEX REPLACE ".*OPENSSL_VERSION_MAJOR[\t ]+([0-9]+).*" "\\1" OPENSSL_VERSION_MAJOR "${openssl_version_major_str}")
+      string(REGEX REPLACE ".*OPENSSL_VERSION_MINOR[\t ]+([0-9]+).*" "\\1" OPENSSL_VERSION_MINOR "${openssl_version_minor_str}")
+      string(REGEX REPLACE ".*OPENSSL_VERSION_PATCH[\t ]+([0-9]+).*" "\\1" OPENSSL_VERSION_FIX "${openssl_version_patch_str}")
+      set(OPENSSL_VERSION "${OPENSSL_VERSION_MAJOR}.${OPENSSL_VERSION_MINOR}.${OPENSSL_VERSION_FIX}")
+    else()
+
     # The version number is encoded as 0xMNNFFPPS: major minor fix patch status
     # The status gives if this is a developer or prerelease and is ignored here.
     # Major, minor, and fix directly translate into the version numbers shown in
@@ -221,6 +238,7 @@ if (OPENSSL_INCLUDE_DIR)
     endif (NOT OPENSSL_VERSION_PATCH STREQUAL "00")
 
     set(OPENSSL_VERSION "${OPENSSL_VERSION_MAJOR}.${OPENSSL_VERSION_MINOR}.${OPENSSL_VERSION_FIX}${OPENSSL_VERSION_PATCH_STRING}")
+    endif()
   endif (_OPENSSL_VERSION)
 
 endif (OPENSSL_INCLUDE_DIR)
