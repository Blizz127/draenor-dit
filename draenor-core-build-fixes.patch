+// Delayed spell cast scheduled onto a unit's EventProcessor. The victim is
+// stored by GUID and resolved at execution time so it is safe if the victim
+// despawns before the delay elapses. The event lives on the caster's own
+// EventProcessor, so a despawning caster tears the pending cast down with it.
+class Unit::DelayedCastEvent : public BasicEvent
+{
+    Unit& m_caster;
+    uint64 m_victimGUID;
+    uint32 m_spellId;
+    bool m_triggered;
+public:
+    DelayedCastEvent(Unit* caster, uint64 victimGUID, uint32 spellId, bool triggered)
+        : BasicEvent(), m_caster(*caster), m_victimGUID(victimGUID), m_spellId(spellId), m_triggered(triggered) {}
+
+    virtual bool Execute(uint64 /*e_time*/, uint32 /*p_time*/)
+    {
+        if (Unit* victim = ObjectAccessor::GetUnit(m_caster, m_victimGUID))
+            m_caster.CastSpell(victim, m_spellId, m_triggered);
+        return true;
+    }
+};
+
+void Unit::CastWithDelay(uint32 delay, Unit* victim, uint32 spellId, bool triggered)
+{
+    uint64 victimGUID = victim ? victim->GetGUID() : 0;
+    m_Events.AddEvent(new DelayedCastEvent(this, victimGUID, spellId, triggered), m_Events.CalculateTime(delay));
+}
