 ARC4::~ARC4()
 {
-    EVP_CIPHER_CTX_cleanup(&m_ctx);
 }
 
 void ARC4::Init(uint8 *seed)
 {
-    EVP_EncryptInit_ex(&m_ctx, NULL, NULL, seed, NULL);
+    // RC4 key-scheduling algorithm with the key length fixed at construction
+    // (matches the old EVP_CIPHER_CTX_set_key_length + EVP_EncryptInit_ex pair).
+    for (int i = 0; i < 256; ++i)
+        m_state[i] = uint8(i);
+
+    uint8 j = 0;
+    for (int i = 0; i < 256; ++i)
+    {
+        j = uint8(j + m_state[i] + seed[i % m_len]);
+        uint8 tmp = m_state[i];
+        m_state[i] = m_state[j];
+        m_state[j] = tmp;
+    }
+
+    m_x = 0;
+    m_y = 0;
+    m_keyed = true;
 }
 
 void ARC4::UpdateData(int len, uint8 *data)
 {
-    int outlen = 0;
-    EVP_EncryptUpdate(&m_ctx, data, &outlen, data, len);
-    EVP_EncryptFinal_ex(&m_ctx, data, &outlen);
+    // Callers (BNet2Crypt, AuthCrypt, Warden) only stream data after Init.
+    if (!m_keyed)
+        return;
+
+    for (int n = 0; n < len; ++n)
+    {
+        m_x = uint8(m_x + 1);
+        m_y = uint8(m_y + m_state[m_x]);
+        uint8 tmp = m_state[m_x];
+        m_state[m_x] = m_state[m_y];
+        m_state[m_y] = tmp;
+        data[n] ^= m_state[uint8(m_state[m_x] + m_state[m_y])];
+    }
 }
